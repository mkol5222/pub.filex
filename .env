# LocalStack Configuration with Assume Role and Custom VPC Endpoints
# This configuration tests the assume role and custom endpoint features

# Base AWS Credentials (for STS assume role)
MYAPP_AWS_ACCESS_KEY_ID=test
MYAPP_AWS_SECRET_ACCESS_KEY=test
MYAPP_AWS_REGION=eu-north-1

# Custom STS endpoint (LocalStack endpoint for assume role)
MYAPP_STS_URL=http://localhost:4566

# IAM Role to assume
# Format: arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME
# In LocalStack, the account ID is 000000000000
MYAPP_ASSUME_ROLE=arn:aws:iam::000000000000:role/cpfeedman-sqs-reader

# SQS Queue URL (standard LocalStack endpoint)
MYAPP_QUEUE_URL=http://sqs.eu-north-1.localhost.localstack.cloud:4566/000000000000/cpfeedman-test-queue

# Custom SQS VPC Endpoint (simulating VPC endpoint usage)
# In this test, we use the same LocalStack endpoint but as a custom VPCE
MYAPP_SQS_VPCE=http://localhost:4566

# Feed mapping
MYAPP_FEEDS_MAP_PATH=./feeds.jsonl

# Logging
MYAPP_LOG_FILE_PATH=/tmp/cpfeedman-localstack-assume-role.log

# Testing flags
MYAPP_SKIP_MANAGEMENT_HA_ACTIVE_CHECK=1
MYAPP_INSECURE=1

GATEWAY_HOST=20.223.226.8 20.223.226.33 172.160.248.183 135.116.64.107
GATEWAY_USER=admin

CPMAN_HOST=128.251.9.44
CPMAN_USER=admin
CPMAN_KEYFILE=~/.ssh/m4.pub
